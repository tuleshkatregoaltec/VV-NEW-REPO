# Bitwarden entries for the platform (ph-box) — project: vitevue-prod
# All secrets below must be set in Bitwarden. Pull with: just env
#
# Lines marked "TO_BE_SET" are placeholders created in Bitwarden — fill these in.
# Lines marked "CF" go to Cloudflare Pages dashboard only, not Bitwarden.

# ── Postgres ──────────────────────────────────────────────────────────────────
POSTGRES_URL=                           # postgresql+asyncpg://vitevue:<password>@localhost:5432/vitevue

# ── Redis ─────────────────────────────────────────────────────────────────────
REDIS_PASSWORD=

# ── Security ──────────────────────────────────────────────────────────────────
SESSION_SECRET=
SERVICE_API_KEY=

# ── Auth (GoTrue) ─────────────────────────────────────────────────────────────
AUTH_SERVICE_ROLE_KEY=                  # TO_BE_SET — generate a strong random key
GOTRUE_JWT_SECRET=                      # TO_BE_SET — generate a strong random secret
GOTRUE_DB_DATABASE_URL=                 # TO_BE_SET — postgres://supabase_auth_admin:<AUTH_DB_PASSWORD>@host.docker.internal:5432/vitevue
API_EXTERNAL_URL=                       # TO_BE_SET — public URL of the auth service, e.g. https://auth.vitevue.com
GOTRUE_SMTP_HOST=                       # TO_BE_SET — SMTP host (e.g. email-smtp.eu-west-1.amazonaws.com)
GOTRUE_SMTP_USER=                       # TO_BE_SET — was SES_USERNAME
GOTRUE_SMTP_PASS=                       # TO_BE_SET — was SES_PASSWORD
GOTRUE_SMTP_ADMIN_EMAIL=                # TO_BE_SET — noreply@your-domain.com

# ── URLs ──────────────────────────────────────────────────────────────────────
FRONTEND_URL=                           # TO_BE_SET — e.g. https://vitevue.com
PUBLIC_API_BASE_URL=                    # TO_BE_SET — e.g. https://api.vitevue.com
FRONTEND_SUCCESS_URL=                   # TO_BE_SET — e.g. https://vitevue.com/dashboard
FRONTEND_CANCEL_URL=                    # TO_BE_SET — e.g. https://vitevue.com/pricing

# ── ClickHouse ────────────────────────────────────────────────────────────────
CLICKHOUSE_PASSWORD=                    # password for the vitevue ClickHouse user

# ── Object storage ────────────────────────────────────────────────────────────
OBJECT_STORAGE_ENDPOINT_URL=            # TO_BE_SET — https://<account-id>.r2.cloudflarestorage.com
OBJECT_STORAGE_ACCESS_KEY_ID=           # TO_BE_SET
OBJECT_STORAGE_SECRET_ACCESS_KEY=       # TO_BE_SET
OBJECT_STORAGE_BUCKET=                  # TO_BE_SET
OBJECT_STORAGE_PUBLIC_URL_BASE=         # TO_BE_SET — e.g. https://media.vitevue.com

# ── Stripe ────────────────────────────────────────────────────────────────────
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID_TIER1=                  # TO_BE_SET
STRIPE_PRICE_ID_TIER2=                  # TO_BE_SET

# ── OpenRouter ────────────────────────────────────────────────────────────────
OPENROUTER_API_KEY=

# ── auth-db-init (first deploy only) ─────────────────────────────────────────
POSTGRES_USER=                          # TO_BE_SET — Postgres user with CREATEROLE privilege (e.g. vitevue)
POSTGRES_PASSWORD=                      # TO_BE_SET — was POSTGRES_ADMIN_PASSWORD
AUTH_DB_PASSWORD=                       # TO_BE_SET — was AUTH_ADMIN_PASSWORD; use in GOTRUE_DB_DATABASE_URL too

# ── Optional ──────────────────────────────────────────────────────────────────
POSTHOG_API_KEY=
HONEYBADGER_API_KEY=

# ── Not needed in Bitwarden ───────────────────────────────────────────────────
# ENVIRONMENT          → hardcoded in docker-compose.yml
# REDIS_URL            → hardcoded (redis://redis:6379)
# AUTH_URL             → hardcoded (http://auth:8081/auth/v1)
# CLICKHOUSE_HOST      → hardcoded (host.docker.internal)
# CLICKHOUSE_PORT      → hardcoded
# CLICKHOUSE_USER      → hardcoded (vitevue)
# CLICKHOUSE_DATABASE  → hardcoded (vitevue)
# CLICKHOUSE_SECURE    → hardcoded (false)
# DEFAULT_CHAT_MODEL   → hardcoded
# OBJECT_STORAGE_PROVIDER → hardcoded (r2)
# OBJECT_STORAGE_REGION   → hardcoded (auto)

# ── Cloudflare Pages dashboard only ──────────────────────────────────────────
# PUBLIC_AUTH_BASE_URL
# PUBLIC_STRIPE_PUBLISHABLE_KEY
# PUBLIC_POSTHOG_HOST
# PUBLIC_POSTHOG_KEY
